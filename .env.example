# Plantilla: copia este archivo como .env y pega tu clave de DeepSeek
DEEPSEEK_API_KEY=tu_api_key_aqui

# Opcional: silencia el aviso de huggingface_hub sobre enlaces simbólicos en
# Windows (la caché de Whisper funciona igual, solo ocupa algo más de disco).
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Matriz en la nube (Azure DevOps). Genera tu PAT en:
#   https://dev.azure.com/<tu-organizacion>/_usersSettings/tokens
# El PAT se usa como contraseña (auth Basic). También puedes ponerlo en
# config_usuario.json -> azure_devops.pat
AZURE_DEVOPS_PAT=
